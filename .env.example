# ---- App ----
# Host-side port for the reverse proxy to forward to.
HOST_PORT=8477
# Public path the app is served under, with leading and trailing slashes. The proxy may forward it
# unchanged or strip it. Changing it requires a rebuild: docker compose up -d --build
BASE_PATH=/

# ---- Online translation (optional) ----
# DeepL API key (free keys end in ":fx"). Leave empty to disable DeepL.
DEEPL_API_KEY=
# Order in which the app's "Automatic" engine setting prefers the available engines.
TRANSLATE_ENGINES=deepl,llm
# Abuse limits for the public API (0 disables): requests per device per hour, characters per day.
TRANSLATE_REQUESTS_PER_HOUR=120
TRANSLATE_CHARS_PER_DAY=50000

# ---- Language model (optional, needs: docker compose --profile llm up -d) ----
# GGUF model from Hugging Face as repo:quantization. The default is Finnish-specialised (Llama 3.3
# license). Alternatives: bartowski/EuroLLM-9B-Instruct-GGUF:Q4_K_M (Apache-2.0),
# ggml-org/gemma-3-12b-it-GGUF:Q4_K_M (Gemma license, needs ~10 GB RAM).
LLM_HF_MODEL=mradermacher/Llama-Poro-2-8B-Instruct-GGUF:Q4_K_M
# Name shown in the app.
LLM_LABEL=Poro 2 (this server)
# Or use a language model server elsewhere (OpenAI-compatible, e.g. Ollama at http://host:11434):
# LLM_URL=http://host:11434
# LLM_MODEL=model-name
# LLM_API_KEY=
